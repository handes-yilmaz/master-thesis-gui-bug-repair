                    "      const pixelHeight = this.sourceImage_.getResolutionY();",
                    "      const width = getWidth(this.targetExtent_) / (this.targetResolution_ * (pixelWidth / pixelHeight));",
                    "      const height = getHeight(this.targetExtent_) / this.targetResolution_;"
                ]
            }
        ]
    }
