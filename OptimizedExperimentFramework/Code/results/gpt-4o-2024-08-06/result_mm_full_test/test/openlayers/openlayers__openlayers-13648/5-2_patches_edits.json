                "REPLACE": [
                    "        const pixelWidth = image.getResolutionX();",
                    "        const pixelHeight = image.getResolutionY();",
                    "        sourceResolutions[level] = getResolution(image, images[0]) * (pixelWidth / pixelHeight);"
                ]
            }
        ],
        "src/ol/reproj/Image.js": [
