        "       * @param {import(\"./proj/Projection.js\").default} dataProjection Data",
        "       * projection.",
        "       */",
        "      function (features, dataProjection) {",
        "        if (success !== undefined) {",
        "          success(features);",
        "        }",
        "        source.addFeatures(features);",
        "      },",
        "      /* FIXME handle error */ failure ? failure : VOID",
        "    );",
        "  };",
        "}",
