        "async function getLatest(patterns) {",
        "  const stats = await globby(patterns, {stats: true});",
        "  let latest = 0;",
        "  for (const stat of stats) {",
        "    if (stat.mtime > latest) {",
        "      latest = stat.mtime;",
        "    }",
        "  }",
        "  return latest;",
