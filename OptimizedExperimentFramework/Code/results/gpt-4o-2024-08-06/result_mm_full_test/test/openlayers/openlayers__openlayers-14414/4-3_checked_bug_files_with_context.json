        "        }",
        "      }",
        "    }",
        "    return resolutions;",
        "  }",
        "",
        "  disposeInternal() {",
        "    if (this.processor_) {",
        "      this.processor_.dispose();",
        "    }",
        "    super.disposeInternal();",
        "  }",
        "}",
        "",
        "/**",
        " * Clean up and unregister the worker.",
        " * @function",
        " * @api",
        " */",
        "RasterSource.prototype.dispose;",
