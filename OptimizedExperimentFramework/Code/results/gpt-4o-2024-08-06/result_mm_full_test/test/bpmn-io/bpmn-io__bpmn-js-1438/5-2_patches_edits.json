{
    "1/1": {
        "lib/features/label-editing/LabelUtil.js": [
            {
                "SEARCH": [
                    "var categoryValueRef = semantic['categoryValueRef'];",
                    "",
                    "if (!categoryValueRef) {",
                    "return '';",
                    "}",
                    "",
                    "",
                    "return categoryValueRef.value || '';",
                    "}",
                    "",
                    "export function getLabel(element) {",
                    "var semantic = element.businessObject,",
                    "attr = getLabelAttr(semantic);",
                    "",
                    "if (attr) {",
                    "",
                    "if (attr === 'categoryValueRef') {",
                    "",
                    "return getCategoryValue(semantic);",
                    "}",
                    "",
                    "return semantic[attr] || '';",
                    "}",
                    "}"
                ],
                "REPLACE": [
                    "  var categoryValueRef = semantic['categoryValueRef'];",
                    "",
                    "  if (!categoryValueRef) {",
                    "    return '';",
                    "  }",
                    "",
                    "",
                    "  return categoryValueRef.value || '';",
                    "}",
                    "",
                    "export function getLabel(element) {",
                    "  var semantic = element.businessObject,",
                    "      attr = getLabelAttr(semantic);",
                    "",
                    "  if (attr) {",
                    "",
                    "    if (attr === 'categoryValueRef') {",
                    "",
                    "      return getCategoryValue(semantic);",
                    "    }",
                    "",
                    "    return semantic[attr] || '';",
                    "  }",
                    "",
                    "  // Handle message elements",
                    "  if (is(semantic, 'bpmn:Message')) {",
                    "    return semantic.name || '';",
                    "  }",
                    "}"
                ]
            }
        ],
        "lib/features/modeling/behavior/LabelBehavior.js": [
            {
                "SEARCH": [
                    "if (!getLabel(element)) {",
                    "return;",
                    "}",
                    "",
                    "var labelCenter = getExternalLabelMid(element);",
                    "",
                    "// we don't care about x and y",
                    "var labelDimensions = textRenderer.getExternalLabelBounds(",
                    "DEFAULT_LABEL_DIMENSIONS,",
                    "getLabel(element)",
                    ");",
                    "",
                    "modeling.createLabel(element, labelCenter, {",
                    "id: businessObject.id + '_label',",
                    "businessObject: businessObject,",
                    "width: labelDimensions.width,",
                    "height: labelDimensions.height",
                    "});"
                ],
                "REPLACE": [
                    "    if (!getLabel(element)) {",
                    "      return;",
                    "    }",
                    "",
                    "    var labelCenter = getExternalLabelMid(element);",
                    "",
                    "    // we don't care about x and y",
                    "    var labelDimensions = textRenderer.getExternalLabelBounds(",
                    "      DEFAULT_LABEL_DIMENSIONS,",
                    "      getLabel(element)",
                    "    );",
                    "",
                    "    modeling.createLabel(element, labelCenter, {",
                    "      id: businessObject.id + '_label',",
                    "      businessObject: businessObject,",
                    "      width: labelDimensions.width,",
                    "      height: labelDimensions.height",
                    "    });",
                    "",
                    "    // Ensure message elements have labels",
                    "    if (is(element, 'bpmn:Message')) {",
                    "      modeling.updateLabel(element, getLabel(element));",
                    "    }"
                ]
            }
        ]
    }
}