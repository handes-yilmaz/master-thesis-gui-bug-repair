            "function_code": [
                "export function getLabel(element) {",
                "  var semantic = element.businessObject,",
                "      attr = getLabelAttr(semantic);",
                "",
                "  if (attr) {",
                "",
                "    if (attr === 'categoryValueRef') {",
                "",
                "      return getCategoryValue(semantic);",
                "    }",
                "",
                "    return semantic[attr] || '';",
                "  }",
                "}"
            ]
        },
        "3": {
            "function_name": "setLabel",
            "file_path": "lib/features/label-editing/LabelUtil.js",
            "function_details": [
                {
                    "name": "setLabel",
                    "start_line": 52,
                    "end_line": 67
                }
            ],
            "function_code": [
                "export function setLabel(element, text, isExternal) {",
                "  var semantic = element.businessObject,",
                "      attr = getLabelAttr(semantic);",
                "",
                "  if (attr) {",
                "",
                "    if (attr === 'categoryValueRef') {",
                "      semantic['categoryValueRef'].value = text;",
                "    } else {",
                "      semantic[attr] = text;",
                "    }",
                "",
                "  }",
                "",
                "  return element;",
                "}"
            ]
        },
        "4": {
            "function_name": "UpdateLabelHandler",
            "file_path": "lib/features/label-editing/cmd/UpdateLabelHandler.js",
            "function_details": [
                {
                    "name": "UpdateLabelHandler",
