            "function_code": [
                "export function collectLanes(shape, collectedShapes) {",
                "",
                "  collectedShapes = collectedShapes || [];",
                "",
                "  shape.children.filter(function(s) {",
                "    if (is(s, 'bpmn:Lane')) {",
                "      collectLanes(s, collectedShapes);",
                "",
                "      collectedShapes.push(s);",
                "    }",
                "  });",
                "",
                "  return collectedShapes;",
                "}"
            ]
        }
    }
