                    "embeddedCode.parentElement?.insertBefore(modalDiv, embeddedCode);",
                    "}",
                    "",
                    "modalBody.appendChild(embeddedCode);",
                    "embeddedCode.classList.delete(kEmbeddedSourceClass);",
                    "}",
