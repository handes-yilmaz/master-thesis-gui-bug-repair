                    "icon.classList.add(\"bi\");",
                    "button.appendChild(icon);",
                    "if (codeTools.caption !== \"none\") {",
                    "button.appendChild(doc.createTextNode(\" \" + codeTools.caption));",
                    "}",
                    "layoutDiv.appendChild(button);",
                    "header!.appendChild(titleDiv);",
