                    "modalDiv.setAttribute(\"tabindex\", \"-1\");",
                    "modalDiv.setAttribute(",
                    "\"aria-labelledby\",",
                    "kEmbeddedSourceModalLabelId,",
                    ");",
                    "modalDiv.setAttribute(\"aria-hidden\", \"true\");",
                    "const modalDialogDiv = doc.createElement(\"div\");",
