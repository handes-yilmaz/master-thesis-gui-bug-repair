                "function printSwitchCaseConsequent(path, options, print) {",
                "  const node = path.getValue();",
                "  const parts = [];",
                "",
                "  if (node.consequent.length === 0) {",
                "    // Handle comments after case/default",
                "    const comments = path.getComments();",
                "    if (comments && comments.length > 0) {",
                "      parts.push(\" \", printDanglingComments(path, options, true));",
                "    }",
                "  }",
                "",
                "  parts.push(printStatementSequence(path, options, print, \"consequent\"));",
                "  return parts;",
                "}"
            ]
        }
