        "  return (function preorder(node, index, parentNode) {",
        "    const newNode = Object.assign({}, handler(node, index, parentNode));",
        "    if (newNode.children) {",
        "      newNode.children = newNode.children.map((child, index) => {",
        "        return preorder(child, index, newNode);",
        "      });",
        "    }",
        "    return newNode;",
