                    "function printChildren(path, options, print, events = {}) {",
                    "  const { processor = print } = events;",
                    "",
                    "  const parts = [];",
                    "",
                    "  path.each(() => {",
                    "    const result = processor(path);",
                    "    if (result !== false) {",
                    "      if (parts.length > 0 && shouldPrePrintHardline(path)) {",
                    "        parts.push(hardline);",
                    "",
                    "        if (",
                    "          shouldPrePrintDoubleHardline(path, options) ||",
                    "          shouldPrePrintTripleHardline(path)",
                    "        ) {",
                    "          parts.push(hardline);",
                    "        }",
                    "",
                    "        if (shouldPrePrintTripleHardline(path)) {",
                    "          parts.push(hardline);",
                    "        }",
                    "      }",
                    "",
                    "      // Ensure empty lines are preserved",
                    "      if (result === hardline && parts[parts.length - 1] === hardline) {",
                    "        parts.push(hardline);",
                    "      }",
                    "",
                    "      parts.push(result);",
                    "    }",
                    "  }, \"children\");",
                    "",
                    "  return parts;",
                    "}"
