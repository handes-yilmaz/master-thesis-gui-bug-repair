{
    "1/1": {
        "path/to/syntax_highlighting_library.js": [
            {
                "SEARCH": [
                    "// Existing logic for handling decorators",
                    "function parsePythonLine(line) {",
                    "// Logic to apply hljs-meta to the entire line",
                    "...",
                    "}"
                ],
                "REPLACE": [
                    "// Updated logic to handle comments correctly",
                    "function parsePythonLine(line) {",
                    "const commentIndex = line.indexOf('#');",
                    "if (commentIndex !== -1) {",
                    "// Apply hljs-meta to the part before the comment",
                    "applyClass(line.substring(0, commentIndex), 'hljs-meta');",
                    "// Apply hljs-comment to the comment part",
                    "applyClass(line.substring(commentIndex), 'hljs-comment');",
                    "} else {",
                    "// Apply hljs-meta to the entire line if no comment",
                    "applyClass(line, 'hljs-meta');",
                    "}",
                    "}"
                ]
            }
        ]
