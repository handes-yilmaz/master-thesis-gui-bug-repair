{
    "1/1": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'meta',",
                    "begin: '% !TeX',",
                    "end: '$',",
                    "relevance: 10",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "className: 'meta',",
                    "begin: /% !TeX/i,  // Make the regex case insensitive",
                    "end: '$',",
                    "relevance: 10",
                    "}"
                ]
            }
        ]
    },
