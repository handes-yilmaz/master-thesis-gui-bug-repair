                "REPLACE": [
                    "    const field = path.match(/([^[.\\\\]]+)/g);",
                    "    let val = object;",
                    "    for (let i = 0; i < field.length; i++) {",
                    "        if (val === undefined) {",
                    "            return undefined;",
                    "        }",
                    "        if (Array.isArray(val) && field[i].includes(',')) {",
                    "            const keys = field[i].slice(1, -1).split(',');",
                    "            val = keys.map(key => val[key.trim()]);",
                    "        } else {",
                    "            val = val[field[i]];",
                    "        }",
                    "    }",
                    "    return val;"
                ]
            }
        ]
    }
