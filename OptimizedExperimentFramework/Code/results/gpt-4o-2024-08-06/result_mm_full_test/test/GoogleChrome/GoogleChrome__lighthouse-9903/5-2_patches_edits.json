                    "}"
                ],
                "REPLACE": [
                    "      if (preconnectOrigins.has(securityOrigin)) {",
                    "        // Check if the preconnect link is used correctly",
                    "        const preconnectLink = preconnectLinks.find(link => URL.getOrigin(link.href || '') === securityOrigin);",
                    "        if (preconnectLink && (!preconnectLink.crossOrigin || preconnectLink.crossOrigin === 'anonymous')) {",
                    "          // If the preconnect link is valid, skip adding a warning",
