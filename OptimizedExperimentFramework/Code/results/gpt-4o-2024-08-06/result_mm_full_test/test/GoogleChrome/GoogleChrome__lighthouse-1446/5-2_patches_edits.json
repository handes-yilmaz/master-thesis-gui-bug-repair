{
    "1/1": {
        "lighthouse-core/audits/first-meaningful-paint.js": [
            {
                "SEARCH": [
                    "if (!tabTrace.firstMeaningfulPaintEvt) {",
                    "throw new Error('No usable `firstMeaningfulPaint` event found in trace');",
                    "}",
                    "",
                    "if (!tabTrace.navigationStartEvt) {",
                    "throw new Error('No `navigationStart` event found in trace');",
                    "}"
                ],
                "REPLACE": [
                    "      if (!tabTrace.firstMeaningfulPaintEvt || !tabTrace.navigationStartEvt) {",
                    "        return FirstMeaningfulPaint.generateAuditResult({",
                    "          rawValue: -1,",
                    "          debugString: 'Essential trace events are missing'",
                    "        });",
                    "      }"
                ]
            }
        ],
        "lighthouse-core/audits/speed-index-metric.js": [
            {
                "SEARCH": [
                    "if (speedline.frames.length === 0) {",
                    "return SpeedIndexMetric.generateAuditResult({",
                    "rawValue: -1,",
                    "debugString: 'Trace unable to find visual progress frames.'",
                    "});",
                    "}",
                    "",
                    "if (speedline.speedIndex === 0) {",
                    "return SpeedIndexMetric.generateAuditResult({",
                    "rawValue: -1,",
                    "debugString: 'Error in Speedline calculating Speed Index (speedIndex of 0).'",
                    "});",
                    "}"
                ],
                "REPLACE": [
                    "      if (speedline.frames.length === 0 || speedline.speedIndex === 0) {",
                    "        return SpeedIndexMetric.generateAuditResult({",
                    "          rawValue: -1,",
                    "          debugString: 'Missing or invalid visual progress frames or Speed Index.'",
                    "        });",
                    "      }"
                ]
            }
        ],
        "lighthouse-core/audits/time-to-interactive.js": [
            {
                "SEARCH": [
                    "if (fmpResult.rawValue === -1) {",
                    "return generateError(fmpResult.debugString);",
                    "}"
                ],
                "REPLACE": [
                    "      if (fmpResult.rawValue === -1 || !speedline.frames) {",
                    "        return generateError('Missing essential metrics for TTI calculation.');",
                    "      }"
                ]
            }
        ]
    }
}