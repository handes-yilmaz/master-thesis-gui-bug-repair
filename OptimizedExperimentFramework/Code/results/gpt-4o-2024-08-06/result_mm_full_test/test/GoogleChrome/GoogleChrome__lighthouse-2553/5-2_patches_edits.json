{
    "1/1": {
        "lighthouse-core/audits/user-timings.js": [
            {
                "SEARCH": [
                    "return {",
                    "name: item.name,",
                    "timingType: item.isMark ? 'Mark' : 'Measure',",
                    "time: time.toLocaleString() + ' ms',",
                    "timeAsNumber: time,",
                    "};"
                ],
                "REPLACE": [
                    "        return {",
                    "          name: item.name,",
                    "          timingType: item.isMark ? 'Mark' : 'Measure',",
                    "          time: time.toLocaleString(undefined, {maximumFractionDigits: 2, minimumFractionDigits: 2}) + ' ms',",
                    "          timeAsNumber: time,",
                    "        };"
                ]
            }
        ]
    }
}