            "function_code": [
                "function createParse({ isMDX }) {",
                "  return (text) => {",
                "    const processor = unified()",
                "      .use(remarkParse, {",
                "        commonmark: true,",
                "        ...(isMDX && { blocks: [BLOCKS_REGEX] }),",
                "      })",
                "      .use(footnotes)",
                "      .use(frontMatter)",
                "      .use(remarkMath)",
                "      .use(isMDX ? esSyntax : noop)",
                "      .use(liquid)",
                "      .use(isMDX ? htmlToJsx : noop)",
                "      .use(wikiLink);",
                "    return processor.run(processor.parse(text));",
                "  };",
                "}"
            ]
        },
