            {
                "SEARCH": [
                    "case \"code\": {",
                    "if (",
                    "// the first char may point to `\\n`, e.g. `\\n\\t\\tbar`, just ignore it",
                    "/^\\n?( {4,}|\\t)/.test(",
                    "options.originalText.slice(",
                    "node.position.start.offset,",
                    "node.position.end.offset",
                    ")",
                    ")",
                    ") {",
                    "// indented code block",
                    "const alignment = \" \".repeat(4);",
                    "return align(",
                    "alignment,",
                    "concat([alignment, join(hardline, node.value.split(\"\\n\"))])",
                    ");",
                    "}",
                    "",
                    "// fenced code block",
                    "const styleUnit = options.__inJsTemplate ? \"~\" : \"`\";",
                    "const style = styleUnit.repeat(",
                    "Math.max(",
                    "3,",
                    "privateUtil.getMaxContinuousCount(node.value, styleUnit) + 1",
                    ")",
                    ");",
                    "return concat([",
                    "style,",
                    "node.lang || \"\",",
                    "hardline,",
                    "join(hardline, node.value.split(\"\\n\")),",
                    "hardline,",
                    "style",
                    "]);",
                    "}"
                ],
                "REPLACE": [
                    "    case \"code\": {",
                    "      const originalIndentation = options.originalText.slice(",
                    "        node.position.start.offset,",
                    "        node.position.end.offset",
                    "      ).match(/^\\n?( {4,}|\\t)/);",
                    "",
                    "      if (originalIndentation) {",
                    "        // indented code block",
                    "        return align(",
                    "          originalIndentation[0],",
                    "          concat([originalIndentation[0], join(hardline, node.value.split(\"\\n\"))])",
                    "        );",
                    "      }",
                    "",
                    "      // fenced code block",
                    "      const styleUnit = options.__inJsTemplate ? \"~\" : \"`\";",
                    "      const style = styleUnit.repeat(",
                    "        Math.max(",
                    "          3,",
                    "          privateUtil.getMaxContinuousCount(node.value, styleUnit) + 1",
                    "        )",
                    "      );",
                    "      return concat([",
                    "        style,",
                    "        node.lang || \"\",",
                    "        hardline,",
                    "        join(hardline, node.value.split(\"\\n\")),",
                    "        hardline,",
                    "        style",
                    "      ]);",
                    "    }"
                ]
            },
            {
                "SEARCH": [
                    "case \"html\": {",
                    "const parentNode = path.getParentNode();",
                    "return parentNode.type === \"root\" &&",
