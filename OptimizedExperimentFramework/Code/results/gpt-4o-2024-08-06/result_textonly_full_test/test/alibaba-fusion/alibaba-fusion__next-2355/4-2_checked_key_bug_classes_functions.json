            "function_code": [
                "export const fetchDataByPath = (object, path) => {",
                "    if (!object || !path) {",
                "        return false;",
                "    }",
                "    path = path.toString();",
                "    const field = path.match(/([^[.\\]]+)/g);",
                "    let val = object;",
                "    for (let i = 0; i < field.length; i++) {",
                "        if (val === undefined) {",
                "            return undefined;",
                "        }",
                "        val = val[field[i]];",
                "    }",
                "    return val;",
                "    return val;",
                "};"
            ]
        }
    }
