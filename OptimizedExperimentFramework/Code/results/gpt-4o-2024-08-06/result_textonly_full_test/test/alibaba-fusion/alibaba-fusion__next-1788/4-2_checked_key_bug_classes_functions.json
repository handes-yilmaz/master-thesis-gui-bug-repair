                "        });",
                "        const innerAfterCls = classNames({",
                "            [innerCls]: true,",
                "            [`${prefix}after`]: true,",
                "            [innerAfterClassName]: innerAfterClassName,",
                "        });",
                "        const previewCls = classNames({",
                "            [`${prefix}form-preview`]: true,",
                "            [className]: !!className,",
