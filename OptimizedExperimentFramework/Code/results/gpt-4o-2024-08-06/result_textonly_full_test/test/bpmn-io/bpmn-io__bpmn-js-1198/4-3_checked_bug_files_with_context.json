        "// helpers //////////////////////",
        "",
        "function isDefaultFlow(connection, source) {",
        "",
        "  if (!is(connection, 'bpmn:SequenceFlow')) {",
        "    return false;",
        "  }",
        "",
        "  var sourceBo = getBusinessObject(source),",
        "      sequenceFlow = getBusinessObject(connection);",
        "",
        "  return sourceBo.get('default') === sequenceFlow;",
        "}"
