                    "",
                    "SubProcessStartEventBehavior.prototype.execute = function(context) {",
                    "  var shape = context.shape;",
                    "",
                    "  if (shape.type === 'bpmn:SubProcess' && shape.isExpanded) {",
                    "    var startEventPosition = getStartEventPosition(shape);",
                    "    var startEvent = this._modeling.createShape({ type: 'bpmn:StartEvent' }, startEventPosition, shape);",
                    "    this._modeling.updateProperties(startEvent, { name: 'Start' });",
                    "  }",
                    "};",
                    "",
                    "// helpers //////////",
                    "",
                    "function getStartEventPosition(shape) {",
                    "  return {",
                    "    x: shape.x + shape.width / 6,",
                    "    y: shape.y + shape.height / 2",
                    "  };",
                    "}"
                ]
            }
