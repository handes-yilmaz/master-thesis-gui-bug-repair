            "function_code": [
                "const getPrimaryContent = (item, index, primaryKey) => {",
                "  let primaryContent;",
                "  if (primaryKey) {",
                "    if (typeof primaryKey === 'function') {",
                "      primaryContent = primaryKey(item, index);",
                "    } else {",
                "      primaryContent = normalize(item, index, primaryKey);",
                "    }",
                "  }",
                "",
                "  return primaryContent;",
                "};"
            ]
