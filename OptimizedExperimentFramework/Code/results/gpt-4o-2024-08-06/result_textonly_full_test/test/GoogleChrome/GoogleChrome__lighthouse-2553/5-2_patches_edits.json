{
    "1/1": {
        "lighthouse-core/report/v2/renderer/util.js": [
            {
                "SEARCH": [
                    "static formatMilliseconds(ms, granularity = 10) {",
                    "const coarseTime = Math.round(ms / granularity) * granularity;",
                    "return `${coarseTime.toLocaleString()}${NBSP}ms`;",
                    "}"
                ],
                "REPLACE": [
                    "  static formatMilliseconds(ms, granularity = 10) {",
                    "    const coarseTime = Math.round(ms / granularity) * granularity;",
                    "    return `${coarseTime.toLocaleString(undefined, {maximumFractionDigits: 0})}${NBSP}ms`;",
                    "  }"
                ]
            },
            {
                "SEARCH": [
                    "static chainDuration(startTime, endTime) {",
                    "return Util.formatNumber((endTime - startTime) * 1000);",
                    "}"
                ],
                "REPLACE": [
                    "  static chainDuration(startTime, endTime) {",
                    "    return ((endTime - startTime) * 1000).toLocaleString(undefined, {maximumFractionDigits: 1});",
                    "  }"
                ]
            }
        ]
    }
}