        "    message: UIStrings.didntCollectScreenshots,",
        "    lhrRuntimeError: true,",
        "  },",
        "  SPEEDINDEX_OF_ZERO: {",
        "    code: 'SPEEDINDEX_OF_ZERO',",
        "..."
