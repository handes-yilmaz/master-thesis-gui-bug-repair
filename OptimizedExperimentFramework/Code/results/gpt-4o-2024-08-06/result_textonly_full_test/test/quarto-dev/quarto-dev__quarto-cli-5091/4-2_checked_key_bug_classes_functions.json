            ],
            "function_code": [
                "export function imageSize(path: string) {",
                "  if (path !== undefined) {",
                "    if (path.endsWith(\".png\")) {",
                "      if (existsSync(path)) {",
                "        const imageData = Deno.readFileSync(path);",
                "        try {",
                "          const png = new PngImage(imageData);",
                "          return {",
                "            height: png.height,",
                "            width: png.width,",
                "          };",
                "        } catch (error) {",
                "          throw new Error(`Error reading file ${path}\\n${error.message}`);",
                "        }",
                "      }",
                "    }",
                "  }",
                "}"
            ]
        }
    }
