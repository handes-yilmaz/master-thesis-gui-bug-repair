            {
                "SEARCH": [
                    "if (name in this.fieldsMeta) {",
                    "this.fieldsMeta[name].value = value;",
                    "}",
                    "if (this.options.parseName) {",
                    "this.values = setIn(this.values, name, value);",
                    "} else {",
                    "this.values[name] = value;",
                    "}",
                    "reRender && this._reRender();"
                ],
                "REPLACE": [
                    "        if (name in this.fieldsMeta) {",
                    "            this.fieldsMeta[name].value = value;",
                    "        }",
                    "        if (this.options.parseName) {",
                    "            this.values = setIn({}, this.values, name, value); // Create a new object",
                    "        } else {",
                    "            this.values = { ...this.values, [name]: value }; // Create a new object",
                    "        }",
                    "        reRender && this._reRender();"
