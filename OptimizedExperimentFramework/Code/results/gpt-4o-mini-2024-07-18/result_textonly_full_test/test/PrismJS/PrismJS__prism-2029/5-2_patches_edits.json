    "1/1": {
        "src/components/prism-d.js": [
            {
                "SEARCH": [
                    "// Original regex for string literals",
                    "string: {",
                    "pattern: /\"(?:\\\\.|[^\"\\\\])*\"/,",
                    "greedy: true",
                    "},"
                ],
                "REPLACE": [
                    "string: {",
                    "pattern: /\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'/,",
                    "greedy: true",
                    "},",
                    "// Adding support for WYSIWYG strings",
                    "wysiwyg: {",
                    "pattern: /`(?:\\\\.|[^`\\\\])*`/,",
                    "greedy: true",
                    "},"
                ]
            }
        ]
    },
