{
    "1/1": {
        "lighthouse-core/audits/image-size-responsive.js": [
            {
                "SEARCH": [
                    "{key: 'url', itemType: 'thumbnail', text: ''},"
                ],
                "REPLACE": [
                    "      {key: 'url', itemType: 'fullpage-screenshot', text: ''},"
                ]
            }
        ],
        "flow-report/src/summary/summary.tsx": [
            {
                "SEARCH": [
                    "<FlowStepThumbnail reportResult={reportResult} width={THUMBNAIL_WIDTH}/>"
                ],
                "REPLACE": [
                    "      <FullPageScreenshot reportResult={reportResult} width={FULL_PAGE_SCREENSHOT_WIDTH}/>"
                ]
            }
        ]
    }
}