    "1/1": {
        "report/renderer/report-renderer.js": [
            {
                "SEARCH": [
                    "[\\'devices\\',\\n        `${envValues.deviceEmulation} with Lighthouse ${report.lighthouseVersion}`,\\n        `${Util.i18n.strings.runtimeSettingsBenchmark}: ${benchmarkIndex}` +\\n            `\\\\n${Util.i18n.strings.runtimeSettingsCPUThrottling}: ${envValues.cpuThrottling}` +\\n            (axeVersion ? `\\\\n${Util.i18n.strings.runtimeSettingsAxeVersion}: ${axeVersion}` : \\'\\')],\\n"
                ],
                "REPLACE": [
                    "      [\\'devices\\',\\n        `${envValues.deviceEmulation} with Lighthouse ${report.lighthouseVersion}` +\\n            `\\\\nScreen Dimensions: ${envValues.screenDimensions}` +\\n            `\\\\nDevice Scale Factor: ${envValues.deviceScaleFactor}`,\\n        `${Util.i18n.strings.runtimeSettingsBenchmark}: ${benchmarkIndex}` +\\n            `\\\\n${Util.i18n.strings.runtimeSettingsCPUThrottling}: ${envValues.cpuThrottling}` +\\n            (axeVersion ? `\\\\n${Util.i18n.strings.runtimeSettingsAxeVersion}: ${axeVersion}` : \\'\\')],\\n"
                ]
            }
        ]
    }
}