            "function_code": [
                "export function shortcodeUnescapePostprocessor(output: string): Promise<void> {",
                "  // unescape shortcodes",
                "  Deno.writeTextFileSync(",
                "    output,",
                "    Deno.readTextFileSync(output)",
                "      .replaceAll(\"{{\\\\<\", \"{{<\")",
                "      .replaceAll(\"\\\\>}}\", \">}}\"),",
                "  );",
                "  return Promise.resolve();",
                "}"
            ]
        }
