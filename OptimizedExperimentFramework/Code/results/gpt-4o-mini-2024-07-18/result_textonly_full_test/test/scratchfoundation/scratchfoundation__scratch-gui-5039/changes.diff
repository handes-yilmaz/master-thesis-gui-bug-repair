diff --git a/src/lib/drag-recognizer.js b/src/lib/drag-recognizer.js
index 1f507785a..58e39fa98 100644
--- a/src/lib/drag-recognizer.js
+++ b/src/lib/drag-recognizer.js
@@ -117,9 +117,22 @@ class DragRecognizer {
         return this._gestureState === DragRecognizer.STATE_DRAG;
     }
 
+    _isRightClick(event) {
+        return event.button === 2; // Check if the right mouse button is clicked
+    }
+
     _isScroll () {
         return this._gestureState === DragRecognizer.STATE_SCROLL;
     }
+
+    handleMouseDown(event) {
+        if (this._isRightClick(event)) {
+            // Prevent default context menu
+            event.preventDefault();
+            // Trigger the duplicate menu logic here
+            this.showDuplicateMenu(event);
+            return;
+        }
 }
 
 export default DragRecognizer;
diff --git a/src/reducers/menus.js b/src/reducers/menus.js
index 4cc494c60..4c1b2ce1d 100644
--- a/src/reducers/menus.js
+++ b/src/reducers/menus.js
@@ -39,6 +39,14 @@ const closeMenu = menu => ({
     type: CLOSE_MENU,
     menu: menu
 });
+
+const showDuplicateMenu = (event) => {
+    // Logic to show the duplicate menu
+    return {
+        type: SHOW_DUPLICATE_MENU,
+        position: { x: event.clientX, y: event.clientY }
+    };
+}
 const openAccountMenu = () => openMenu(MENU_ACCOUNT);
 const closeAccountMenu = () => closeMenu(MENU_ACCOUNT);
 const accountMenuOpen = state => state.scratchGui.menus[MENU_ACCOUNT];
