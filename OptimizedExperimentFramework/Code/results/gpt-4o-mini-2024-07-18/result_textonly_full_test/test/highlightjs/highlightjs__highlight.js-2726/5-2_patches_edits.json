{
    "1/1": {
        "src/lib/token_tree.js": [
            {
                "SEARCH": [
                    "this.openNode(kind);",
                    "this.addText(text);",
                    "this.closeNode();"
                ],
                "REPLACE": [
                    "const braceRegex = /{([^}]*)}/g;",
                    "let match;",
                    "while ((match = braceRegex.exec(text)) !== null) {",
                    "this.openNode(kind);",
                    "this.addText(match[1]); // Add content inside braces",
                    "this.closeNode();",
                    "}"
                ]
            },
            {
                "SEARCH": [
                    "this.add(text);"
                ],
                "REPLACE": [
                    "const braceRegex = /{([^}]*)}/g;",
                    "let match;",
                    "while ((match = braceRegex.exec(text)) !== null) {",
                    "this.add(match[1]); // Add content inside braces",
                    "}"
                ]
            }
        ]
    },
