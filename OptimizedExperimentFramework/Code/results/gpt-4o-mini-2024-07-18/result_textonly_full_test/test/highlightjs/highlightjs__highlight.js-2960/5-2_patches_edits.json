        "src/lib/regex.js": [
            {
                "SEARCH": [
                    "const joined = args.map((x) => source(x)).join(\"\");"
                ],
                "REPLACE": [
                    "const joined = args.map((x) => {",
                    "// Check if x is a string and starts with 'm' for m-style regex",
                    "if (typeof x === 'string' && x.startsWith('m')) {",
                    "// Extract the regex pattern and delimiter",
                    "const parts = x.match(/^m([^\\w\\s])(.+?)\\1$/);",
                    "if (parts) {",
                    "return parts[2]; // Return the regex pattern without the m and delimiter",
                    "}",
                    "}",
                    "return source(x);",
                    "}).join(\"\");"
                ]
            }
        ]
