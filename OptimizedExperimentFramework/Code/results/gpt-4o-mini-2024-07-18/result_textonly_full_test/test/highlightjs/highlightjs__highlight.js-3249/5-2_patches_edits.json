{
    "1/1": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "className: 'MAGIC_COMMENT',",
                    "begin: '% !TeX program = ',",
                    "end: '$',",
                    "relevance: 10"
                ],
                "REPLACE": [
                    "className: 'MAGIC_COMMENT',",
                    "begin: '% !TeX program = ',",
                    "end: '$',",
                    "relevance: 10,",
                    "illegal: /[^\\s]/,",
                    "contains: [",
                    "{",
                    "begin: '% !TEX encoding = ',",
                    "end: '$',",
                    "relevance: 10,",
                    "case_insensitive: true",
                    "}",
                    "]"
                ]
            }
        ]
    },
