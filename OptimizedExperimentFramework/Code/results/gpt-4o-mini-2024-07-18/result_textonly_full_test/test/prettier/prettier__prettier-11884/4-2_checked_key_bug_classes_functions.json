            ],
            "function_code": [
                "function isProbablyJsx(text) {",
                "  return new RegExp(",
                "    [",
                "      \"(?:^[^\\\"'`]*</)\", // Contains \"</\" when probably not in a string",
                "      \"|\",",
                "      \"(?:^[^/]{2}.*/>)\", // Contains \"/>\" on line not starting with \"//\"",
                "    ].join(\"\"),",
                "    \"m\"",
                "  ).test(text);",
                "}"
            ]
        }
    }
