{
    "1/1": {
        ".eslintrc.js": [
            {
                "SEARCH": [
                    "\"key-spacing\": [\"warn\", {",
                    "\"multiLine\": {\"align\": \"value\"},"
                ],
                "REPLACE": [
                    "    \"key-spacing\": [\"warn\", {",
                    "      \"multiLine\": {\"align\": \"value\"},",
                    "      \"beforeColon\": true,",
                    "      \"afterColon\": true,"
                ]
            }
        ]
    }
}