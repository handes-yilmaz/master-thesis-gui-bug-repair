            "function_code": [
                "export function get(sourceCode, destinationCode) {",
                "  let transform;",
                "  if (sourceCode in transforms && destinationCode in transforms[sourceCode]) {",
                "    transform = transforms[sourceCode][destinationCode];",
                "  }",
                "  return transform;",
