            "function_code": [
                "async function getScreenshotsMismatch(entry) {",
                "  const actual = getActualScreenshotPath(entry);",
                "  const expected = getExpectedScreenshotPath(entry);",
                "  let mismatch, error;",
                "  try {",
                "    mismatch = await match(actual, expected);",
                "  } catch (err) {",
                "    error = err;",
                "  }",
                "  return {error, mismatch};",
                "}"
            ]
        },
