                    "   * @private",
                    "   */",
                    "  terminateWorkers() {",
                    "    if (this.worker_) {",
                    "      this.worker_.terminate();",
                    "      this.worker_ = null;",
                    "    }",
                    "  }",
                    "",
                    "  /**",
                    "   * Set the operation.",
