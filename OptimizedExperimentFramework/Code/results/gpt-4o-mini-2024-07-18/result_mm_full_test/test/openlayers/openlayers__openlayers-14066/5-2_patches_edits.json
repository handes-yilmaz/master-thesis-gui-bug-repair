                    "                          ['CMYK', 'YCbCr', 'CIELab', 'ICCLab'].includes(source.photometric));",
                    "      this.readMethod_ = isAutoRGB ? 'readRGB' : 'readRasters';",
                    "    } else {",
                    "      this.readMethod_ = options.convertToRGB ? 'readRGB' : 'readRasters';",
                    "    }"
                ]
            }
