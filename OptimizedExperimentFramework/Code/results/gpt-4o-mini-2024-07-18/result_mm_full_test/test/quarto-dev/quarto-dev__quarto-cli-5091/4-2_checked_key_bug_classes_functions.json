            "function_code": [
                "export function bibEngine(defaults: FormatPandoc, flags?: PandocFlags) {",
                "  return flags?.natbib",
                "    ? \"natbib\"",
                "    : flags?.biblatex",
                "    ? \"biblatex\"",
                "    : defaults[kCiteMethod] === \"natbib\"",
                "    ? \"natbib\"",
                "    : defaults[kCiteMethod] == \"biblatex\"",
                "    ? \"biblatex\"",
                "    : undefined;",
                "}"
            ]
        },
        "2": {
