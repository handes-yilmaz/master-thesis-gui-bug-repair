            ],
            "function_code": [
                "export function isLatexPdfEngine(engine: PdfEngine) {",
                "  return [\"pdflatex\", \"xelatex\", \"lualatex\", \"latexmk\"].includes(",
                "    engine.pdfEngine,",
                "  );",
                "}"
            ]
        },
        "3": {
            "function_name": "useContextPdfOutputRecipe",
            "file_path": "src/command/render/output-tex.ts",
            "function_details": [
                {
                    "name": "useContextPdfOutputRecipe",
