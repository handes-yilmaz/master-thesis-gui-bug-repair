            "function_code": [
                "function shouldPrePrintHardline({ node, parent }) {",
                "  const isInlineNode = INLINE_NODE_TYPES.has(node.type);",
                "",
                "  const isInlineHTML =",
                "    node.type === \"html\" && INLINE_NODE_WRAPPER_TYPES.has(parent.type);",
                "",
                "  return !isInlineNode && !isInlineHTML;",
                "}"
            ]
        },
