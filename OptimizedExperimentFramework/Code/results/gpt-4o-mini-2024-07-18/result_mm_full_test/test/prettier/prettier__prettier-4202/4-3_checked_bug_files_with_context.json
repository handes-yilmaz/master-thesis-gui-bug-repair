        "          clamp(options.tabWidth - listPrefix.length, 0, 3) // 4+ will cause indented code block",
        "        );",
        "        return concat([alignment, align(alignment, childPath.call(print))]);",
        "      }",
        "    })",
        "  ]);",
        "}",
