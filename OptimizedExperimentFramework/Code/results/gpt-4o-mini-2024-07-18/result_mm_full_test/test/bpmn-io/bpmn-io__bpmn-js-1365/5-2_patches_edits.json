                    "    // existing rendering logic",
                    "    const collectionToggle = document.createElement('input');",
                    "    collectionToggle.type = 'checkbox';",
                    "    collectionToggle.checked = dataObject.isCollection;",
                    "    collectionToggle.addEventListener('change', (event) => {",
                    "        dataObject.isCollection = event.target.checked; // Toggle isCollection",
                    "    });",
                    "    // Append the toggle to the UI",
                    "    document.body.appendChild(collectionToggle);",
                    "}"
                ]
            }
