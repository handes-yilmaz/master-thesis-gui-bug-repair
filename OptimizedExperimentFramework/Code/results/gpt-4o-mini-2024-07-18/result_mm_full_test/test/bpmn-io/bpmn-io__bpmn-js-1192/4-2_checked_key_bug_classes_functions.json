            "function_code": [
                "function removeProperties(element, properties) {",
                "  if (!isArray(properties)) {",
                "    properties = [ properties ];",
                "  }",
                "",
                "  forEach(properties, function(property) {",
                "    if (element[property]) {",
                "      delete element[property];",
                "    }",
                "  });",
                "}"
            ]
