            {
                "SEARCH": [
                    "if (attr) {",
                    "if (attr === 'categoryValueRef') {",
                    "semantic['categoryValueRef'].value = text;",
                    "} else {",
                    "semantic[attr] = text;",
                    "}",
                    "}"
                ],
                "REPLACE": [
                    "  if (attr) {",
                    "    if (text === '') {",
                    "      // Prevent setting the label to an empty string",
