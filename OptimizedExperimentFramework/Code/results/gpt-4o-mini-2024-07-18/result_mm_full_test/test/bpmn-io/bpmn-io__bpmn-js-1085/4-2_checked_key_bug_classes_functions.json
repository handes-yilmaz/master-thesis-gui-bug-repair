                "function getWaypoints(bo, source, target) {",
                "",
                "  var waypoints = bo.di.waypoint;",
                "",
                "  if (!waypoints || waypoints.length < 2) {",
                "    return [ getMid(source), getMid(target) ];",
                "  }",
                "",
                "  return waypoints.map(function(p) {",
                "    return { x: p.x, y: p.y };",
                "  });",
                "}"
