{
    "1/1": {
        ".eslintrc.js": [
            {
                "SEARCH": [
                    "\"rules\": {",
                    "\"prefer-const\": \"error\",",
                    "\"no-undef-init\": \"warn\""
                ],
                "REPLACE": [
                    "    \"rules\": {",
                    "        \"no-undef-init\": \"warn\",",
                    "        \"prefer-const\": \"error\""
                ]
            }
        ]
    }
}