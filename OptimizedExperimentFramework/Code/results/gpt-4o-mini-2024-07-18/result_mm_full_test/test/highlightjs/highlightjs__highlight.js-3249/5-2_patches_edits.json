{
    "1/1": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "// Existing MAGIC_COMMENT rule",
                    "{",
                    "className: 'magic-comment',",
                    "begin: /% !TeX/,",
                    "end: /$/,",
                    "relevance: 10",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'magic-comment',",
                    "begin: /% ![Tt][Ee][Xx]/, // Updated to be case insensitive",
                    "end: /$/,",
                    "relevance: 10",
                    "},"
                ]
            }
        ]
    },
