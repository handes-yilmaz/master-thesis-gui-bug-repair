{
    "1/1": {
        "// Hypothetical patch for syntax highlighting rules in bash": [
            {
                "SEARCH": [
                    "// Existing syntax highlighting rules",
                    "// ..."
                ],
                "REPLACE": [
                    "// Add rules for heredoc and other constructs",
                    "{",
                    "className: 'heredoc',",
                    "begin: /<<</,",
                    "end: /EOF/, // Adjust as necessary for different EOF markers",
                    "relevance: 10",
                    "},",
                    "{",
                    "className: 'pipe',",
                    "begin: /\\|/,",
                    "relevance: 5",
                    "},",
                    "{",
                    "className: 'continuation',",
                    "begin: /\\\\$/,",
                    "relevance: 5",
                    "},",
                    "{",
                    "className: 'stream-redirection',",
                    "begin: /<|>/,",
                    "relevance: 5",
                    "},",
                    "{",
                    "className: 'subshell',",
                    "begin: /\\$\\(/,",
                    "end: /\\)/,",
                    "relevance: 10",
                    "},"
                ]
            }
        ]
    },
