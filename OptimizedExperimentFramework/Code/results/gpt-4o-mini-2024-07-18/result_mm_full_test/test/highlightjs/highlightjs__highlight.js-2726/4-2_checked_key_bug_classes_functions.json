            "function_code": [
                "export const COMMENT = function(begin, end, modeOptions = {}) {",
                "  var mode = inherit(",
                "    {",
                "      className: 'comment',",
                "      begin,",
                "      end,",
                "      contains: []",
                "    },",
                "    modeOptions",
                "  );",
                "  mode.contains.push(PHRASAL_WORDS_MODE);",
                "  mode.contains.push({",
                "    className: 'doctag',",
                "    begin: '(?:TODO|FIXME|NOTE|BUG|OPTIMIZE|HACK|XXX):',",
                "    relevance: 0",
                "  });",
                "  return mode;",
                "};"
            ]
        }
