{
    "1/1": {
        "lighthouse-core/report/report-generator.js": [
            {
                "SEARCH": [
                    "lhresults: this._escapeScriptTags(JSON.stringify(results, null, 2)),"
                ],
                "REPLACE": [
                    "      lhresults: this._escapeScriptTags(this._sanitizeJSONStringify(results)),"
                ]
            },
            {
                "SEARCH": [
                    "/**",
                    "* Escape closing script tags.",
                    "* @param {string} jsonStr",
                    "* @return {string}",
                    "*/",
                    "_escapeScriptTags(jsonStr) {",
                    "return jsonStr.replace(/<\\\\/script>/g, '<\\\\\\\\/script>');",
                    "}"
                ],
                "REPLACE": [
                    "  /**",
                    "   * Safely stringify JSON to prevent injection attacks.",
                    "   * @param {Object} obj",
                    "   * @return {string} Safe JSON string",
                    "   */",
                    "  _sanitizeJSONStringify(obj) {",
                    "    const jsonString = JSON.stringify(obj, (key, value) => {",
                    "      if (typeof value === 'string') {",
                    "        return value.replace(/</g, '&lt;').replace(/>/g, '&gt;');",
                    "      }",
                    "      return value;",
                    "    }, 2);",
                    "    return jsonString;",
                    "  }"
                ]
            }
        ]
    }
}