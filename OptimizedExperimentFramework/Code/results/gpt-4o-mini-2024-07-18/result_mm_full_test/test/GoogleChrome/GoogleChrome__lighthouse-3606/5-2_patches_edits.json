{
    "1/1": {
        "// Example patch for enabling compression in Express": [
            {
                "SEARCH": [
                    "const express = require('express');",
                    "const app = express();"
                ],
                "REPLACE": [
                    "const express = require('express');",
                    "const compression = require('compression'); // Import compression middleware",
                    "const app = express();",
                    "",
                    "app.use(compression()); // Use compression middleware"
                ]
            }
        ]
    }
}