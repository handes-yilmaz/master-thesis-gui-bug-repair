                    "if (commandMatch) {",
                    "return [",
                    "{ type: 'command', content: commandMatch[1].trim() },",
                    "{ type: 'prompt', content: commandMatch[2].trim() }",
                    "];",
                    "}",
                    "return { type: 'output', content: line };",
                    "});"
                ]
            }
        ]
